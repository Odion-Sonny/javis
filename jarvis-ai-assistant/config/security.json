    "uptime",
    "df",
    "du",
    "free",
    "ps",
    "top",
    "htop",
    "who",
    "w",
    "last",
    "history",
    "uname",
    "hostname",
    "echo",
    "printf",
    "wc",
    "sort",
    "uniq",
    "cut",
    "awk",
    "sed",
    "tr",
    "tee",
    "diff",
    "cmp"
  ],
  "blocked_paths": [
    "/etc",
    "/usr",
    "/bin",
    "/sbin",
    "/boot",
    "/proc",
    "/sys",
    "/dev",
    "/root",
    "/var/log",
    "/var/run",
    "/tmp/.*\\.sh$",
    "/tmp/.*\\.py$",
    "/tmp/.*\\.exe$",
    "C:\\Windows",
    "C:\\Program Files",
    "C:\\System32"
