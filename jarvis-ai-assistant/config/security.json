    "rmdir",
    "del",
    "format",
    "fdisk",
    "mkfs",
    "dd",
    "sudo",
    "su",
    "passwd",
    "chmod",
    "chown",
    "kill",
    "killall",
    "pkill",
    "reboot",
    "shutdown",
    "halt",
    "poweroff",
    "init",
    "systemctl",
    "service",
    "mount",
    "umount",
    "crontab",
    "at",
    "batch",
    "nc",
    "netcat",
    "telnet",
    "ssh",
    "scp",
    "rsync",
    "wget",
    "curl",
    "ftp",
    "sftp",
    "python",
    "python3",
    "perl",
    "ruby",
    "node",
    "npm",
    "pip",
    "gem",
    "docker",
    "podman",
    "kubectl",
    "helm"
  ],
  "allowed_commands": [
    "ls",
    "dir",
    "pwd",
    "cd",
    "cat",
    "more",
    "less",
    "head",
    "tail",
    "grep",
    "find",
    "which",
    "whereis",
