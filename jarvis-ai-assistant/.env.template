# Jarvis AI Assistant - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =====================================
# AI Configuration
# =====================================

# AI Provider: 'openai', 'anthropic', or 'mock'
JARVIS_AI_PROVIDER=mock

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
JARVIS_AI_API_KEY=your_openai_api_key_here
JARVIS_AI_MODEL=gpt-3.5-turbo

# Anthropic Configuration (alternative to OpenAI)
# Get your API key from: https://console.anthropic.com/
# JARVIS_AI_API_KEY=your_anthropic_api_key_here
# JARVIS_AI_MODEL=claude-3-sonnet-20240229

# Custom API Base URL (optional)
# JARVIS_AI_BASE_URL=https://your-custom-endpoint.com/v1

# =====================================
# Voice Configuration
# =====================================

# Wake word to activate voice mode
JARVIS_VOICE_WAKE_WORD=jarvis

# Language for speech recognition
JARVIS_VOICE_LANGUAGE=en-US

# Voice engine (default, or specific TTS engine)
JARVIS_VOICE_ENGINE=default

# =====================================
# Memory Configuration
# =====================================

# Path to memory database file
JARVIS_MEMORY_DB_PATH=jarvis_memory.db

# Maximum context length (in tokens)
JARVIS_MEMORY_MAX_CONTEXT=4000

# Context window in hours (how far back to remember)
JARVIS_MEMORY_CONTEXT_WINDOW_HOURS=24

# =====================================
# System Tools Configuration
# =====================================

# Enable/disable system tools execution
JARVIS_SYSTEM_TOOLS_ENABLED=true

# Maximum execution time for commands (seconds)
JARVIS_SYSTEM_TOOLS_MAX_EXECUTION_TIME=30

# =====================================
# Logging Configuration
# =====================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
JARVIS_LOG_LEVEL=INFO

# Log file path
JARVIS_LOG_FILE=logs/jarvis.log

# =====================================
# Security Configuration
# =====================================

# Require user confirmation for system commands
JARVIS_SECURITY_REQUIRE_CONFIRMATION=true

# Enable safe mode (additional security restrictions)
JARVIS_SECURITY_SAFE_MODE=true

# =====================================
# Optional: Advanced Configuration
# =====================================

# Custom configuration file path
# JARVIS_CONFIG_FILE=config/jarvis.json

# Database connection string (for advanced setups)
# JARVIS_DATABASE_URL=sqlite:///jarvis.db

# API rate limiting (requests per minute)
# JARVIS_API_RATE_LIMIT=60

# =====================================
# Development Settings
# =====================================

# Enable debug mode
# JARVIS_DEBUG=true

# Disable certain features for testing
# JARVIS_VOICE_ENABLED=false
# JARVIS_SYSTEM_TOOLS_ENABLED=false

# Mock API responses (for development without API keys)
# JARVIS_USE_MOCK_AI=true